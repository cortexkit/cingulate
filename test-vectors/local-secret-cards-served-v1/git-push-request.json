{
  "kind": "consent",
  "title": "Let git push to example.test/org/repo with your saved credentials?",
  "prompt": "Git never sees the token. AFT adds your saved sign-in only to requests to example.test.",
  "facts": [
    {
      "label": "Command",
      "value": "git-remote-https origin https://example.test/org/repo.git"
    },
    {
      "label": "Folder",
      "value": "/work/project"
    },
    {
      "label": "Agent",
      "value": "Fake agent"
    },
    {
      "label": "The agent says",
      "value": "push the fake repository"
    }
  ],
  "options": [
    {
      "id": "once",
      "label": "Allow once",
      "effect": "grant"
    },
    {
      "id": "hour",
      "label": "Allow for 1 hour",
      "effect": "grant"
    },
    {
      "id": "session",
      "label": "Allow for this session",
      "effect": "grant"
    },
    {
      "id": "decline",
      "label": "Decline",
      "effect": "decline"
    }
  ],
  "default": "decline",
  "urgency": "normal",
  "on_expiry": "deny",
  "material_damage": false,
  "late_execution": "notify_only",
  "target": {
    "kind": "git",
    "label": "example.test/org/repo"
  },
  "expires_in_ms": 600000,
  "scope": {
    "owner": {
      "kind": "reserved",
      "module_id": "prefrontal-core"
    },
    "kind": "worker",
    "scope_ref": "fake-agent",
    "scope_epoch": 7
  }
}
