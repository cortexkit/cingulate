{"method":"consent.request","params":{"default":"deny","dry_run_text":{"problems":[],"summary":"In the last 24 h it would have run once, at 08:00. The run stopped at its first read, because a flow that isn't approved yet doesn't read live data.","would":["Schedule a run","Schedule a run","Schedule a run","Schedule a run","Schedule a run","Schedule a run","Schedule a run","Schedule a run","Schedule a run"]},"expires_in_ms":60000,"facts":[{"label":"Runs","value":"Every day at 08:00"},{"label":"Can wake","value":"Yes, at the scheduled time"},{"label":"Token limit","value":"5,000 per run"}],"flow_install":{"flow":"morning-summary","manifest":{"schedule":"daily"}},"kind":"flow_install","late_execution":"execute","material_damage":true,"on_expiry":"deny","options":[{"effect":"grant","id":"allow_once","label":"Allow once"},{"effect":"decline","id":"deny","label":"Not now"}],"prompt":"Allow this scheduled summary flow?","scope":{"flow_id":"morning-summary"},"source":{"language":"javascript","text":"export default flow({\n  schedule: { at: \"08:00\", tz: \"Europe/Madrid\" },\n  async run(ctx) {\n    const board = await ctx.board.read();\n    await ctx.inbox.send({ title: \"Morning summary\", body: board.digest() });\n  },\n});\n"},"target":{"kind":"flow","label":"morning-summary"},"title":"Install morning summary","urgency":"normal"}}