# Rust build output
target/

# Local editor and OS files
.DS_Store

# Local agent tooling state under .cortexkit/: working copies, reports, saved
# answers and per-machine settings. None of it is source, and committing it would
# put one maintainer's local setup into everyone's checkout.
#
# .cortexkit/WORKER.md is NOT ignored on purpose: it is the repository's
# instruction file for automated contributors, reviewed like any other file.
# The maintainer's own tool configuration (the .jsonc files) stays local.
.cortexkit/*.jsonc
.cortexkit/alfonso/
.cortexkit/prefrontal/
.cortexkit/magic-context/
.cortexkit/internal-docs/
.cortexkit/scripts/
.cortexkit/sidekick-answers/
